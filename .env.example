# ──────────────────────────────────────────────
# RobinHood AI Trader — Environment Config
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Safety: keep false until you have tested thoroughly in dry-run mode
TRADING_ENABLED=false

# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Base URL for the OAuth callback (must be reachable from your browser)
# For local Docker: http://localhost
# For a VPS/cloud host: https://your-domain.com
CALLBACK_BASE_URL=http://localhost

# LLM provider keys — configure via the Settings UI instead if you prefer
# These are optional here; the UI stores them encrypted in the database.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...
